# Configuración para desarrollo local de SIREP.
# Copiar como .env y generar una SECRET_KEY propia.
DEBUG=True
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_LOCAL
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 18 local. Crear previamente esta base y este usuario.
DB_NAME=sirep_db
DB_USER=sirep_user
# Contraseña elegida al crear sirep_user en PostgreSQL (no la de postgres).
# Completar solo en el archivo privado .env.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
